# Copiar a backend/.env (chmod 600). Nunca versionar el .env real.

# Clave para los HMAC de tokens de sesión/invitación. Generar con:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# Dentro del contenedor la DB vive en el volumen ./data
DATABASE_URL=sqlite:////app/data/tracker.db

# URL pública (se usa para armar los links de invitación)
PUBLIC_URL=https://tracker.example.com

COOKIE_SECURE=true
SCHEDULER_ENABLED=true

# Bot de Telegram para las alertas (vacío = sin Telegram; queda el historial in-app)
TELEGRAM_BOT_TOKEN=

# FlareSolverr corre en el host (puerto 8191)
FLARESOLVERR_URL=http://host.docker.internal:8191/v1

# Segundos mínimos entre peticiones al mismo dominio
DOMAIN_MIN_INTERVAL=5

# Sesión persistente de FlareSolverr (reutiliza la cookie de Cloudflare entre lecturas)
# FLARESOLVERR_SESSION=price_tracker

# MercadoLibre (OAuth; el admin conecta la cuenta desde el panel)
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Por defecto: $PUBLIC_URL/api/admin/meli/callback (debe ser la registrada en la app)
# MELI_REDIRECT_URI=
