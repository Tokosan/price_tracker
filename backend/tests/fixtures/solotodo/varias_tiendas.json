88,"unicode":"M.2 2230","name":"M.2 2230"}],"name":"M.2 2242"}],"ssd_type_connector_name":"M.2 2280","picture":"products/2016851_picture_1739199052.png","line_id":2016873,"line_unicode":"A-DATA Legend 860","line_family_id":532241,"line_family_unicode":"A-DATA","line_family_name":" ","line_family_brand_id":532061,"line_family_brand_unicode":"A-DATA","line_family_brand_brand_id":104083,"line_family_brand_brand_unicode":"A-DATA","line_family_brand_brand_name":"A-DATA","line_name":"Legend 860","nand_type_id":1460949,"nand_type_unicode":"QLC","nand_type_name":"QLC","capacity_id":532223,"capacity_unicode":"2 TB","capacity_value":2000,"sequential_read_speed":6000,"sequential_write_speed":5000,"brand_unicode":"A-DATA","pretty_sequential_read_speed":"6000 MB/s","pretty_sequential_write_speed":"5000 MB/s","warnings":["No estamos seguros si este SSD posee memoria DRAM propia o no"],"default_bucket":2016875},"description":"# SSD ADATA LEGEND 860 2TB M.2 PCIe 4.0 NVMe\n\nEl **ADATA LEGEND 860** es una unidad de estado sólido interna de alta capacidad y rendimiento, diseñada para usuarios que requieren velocidades de transferencia rápidas y gran espacio de almacenamiento. Con una capacidad de **2 TB** y formato **M.2 2280**, este SSD utiliza la interfaz **PCIe Gen4 x4** y el protocolo **NVMe 2.0**, lo que le permite alcanzar velocidades de lectura secuencial de hasta **6000 MB/s** y escritura secuencial de hasta **5000 MB/s**.\n\nEste modelo es ideal para mejorar el rendimiento de PCs, notebooks y consolas como la **PlayStation 5**, gracias a su compatibilidad y certificación para expansión de almacenamiento oficial en esta última. Además, incorpora tecnologías avanzadas como **SLC Caching**, **Host Memory Buffer (HMB)** y corrección de errores **LDPC ECC**, que optimizan la estabilidad, integridad y velocidad de transferencia de datos.\n\nSu diseño compacto y ligero facilita la instalación en equipos con ranuras M.2 2280, mientras que su resistencia a golpes y amplio rango de temperatura operativa aseguran un funcionamiento confiable en diversas condiciones.\n\n---\n\n## Características destacadas\n\n- **Capacidad de 2 TB** para almacenamiento amplio de juegos, aplicaciones, multimedia y proyectos profesionales.\n- **Velocidades de lectura y escritura secuenciales** de hasta 6000/5000 MB/s gracias a la interfaz PCIe Gen4 x4 y protocolo NVMe 2.0.\n- **Formato M.2 2280** compacto compatible con PCs, notebooks y consolas PS5.\n- Tecnologías avanzadas: **SLC Caching**, **Host Memory Buffer (HMB)** y corrección de errores **LDPC ECC** para mayor rendimiento y fiabilidad.\n- Alta durabilidad y resistencia: **TBW de 640 TB**, **MTBF de 2.000.000 horas** y resistencia a golpes de **1500 G**.\n- Amplio rango de temperatura operativa: **0 °C a 70 °C**, adecuado para uso intensivo.\n- Compatibilidad certificada con **PlayStation 5** para expansión de almacenamiento oficial.\n\n---\n\n## Pros\n\n- Excelente rendimiento con velocidades PCIe 4.0 que mejoran significativamente los tiempos de carga y transferencia.\n- Gran capacidad de almacenamiento que permite guardar grandes bibliotecas de juegos, archivos multimedia y proyectos profesionales.\n- Compatible con las últimas plataformas Intel y AMD, además de consolas PS5.\n- Diseño compacto y ligero que facilita la instalación en notebooks y PCs de escritorio.\n- Tecnologías de caché y corrección de errores que garantizan estabilidad y seguridad en la transferencia de datos.\n- Resistencia física y térmica que asegura un funcionamiento confiable en ambientes exigentes.\n\n---\n\n## Contras\n\n- La memoria NAND QLC puede ofrecer menor durabilidad y rendimiento sostenido en comparación con memorias TLC o MLC en cargas muy intensivas.\n- El uso de Host Memory Buffer (HMB) implica que parte de la memoria RAM del sistema se utiliza como caché, lo que puede afectar ligeramente el rendimiento en sistemas con poca RAM.\n- Aunque es compatible con PCIe 3.0, no alcanza sus máximas velocidades en plataformas más antiguas.\n\n---\n\nEste SSD es una opción sólida para usuarios en Chile que buscan un equilibrio entre alta capacidad, velocidad y compatibilidad con equipos modernos y consolas de última generación. Ideal para gamers, creadores de contenido y profesionales que requieren un almacenamiento rápido y confiable.","meta_tag_description":"SSD ADATA LEGEND 860 de 2TB, M.2 2280 PCIe 4.0 NVMe, con velocidades de hasta 6000 MB/s lectura y 5000 MB/s escritura, ideal para PC, laptops y PS5.","short_description":"SSD M.2 2280 PCIe 4.0, 2TB, 6000 MB/s lectura y 5000 MB/s escritura"}, "available": {"count":1,"next":null,"previous":null,"results":[{"product":{"id":265617,"name":"A-DATA Legend 860 2 TB (SLEG-860-2000GCS)","category_id":39,"category":39,"slug":"a-data-legend-860-2-tb-sleg-860-2000gcs","instance_model_id":2016875,"creation_date":"2025-02-10T14:53:14.898130Z","last_updated":"2026-05-22T00:10:32.516553Z","picture_url":"https://media.solotodo.com/media/products/2016851_picture_1739199052.png","brand":{"id":348,"name":"A-DATA"},"part_number":"SLEG-860-2000GCS","sec_qr_codes":null,"specs":{"id":2016875,"unicode":"A-DATA Legend 860 2 TB (SLEG-860-2000GCS)","part_number":"SLEG-860-2000GCS","has_dram_id":1460592,"has_dram_unicode":"Desconocido","has_dram_ordering":3,"has_dram_name":"Desconocido","ssd_type_id":1687015,"ssd_type_unicode":"M.2 (2280) / PCIe 4.0 x4 / Conector M.2 2280","ssd_type_format_id":1560419,"ssd_type_format_unicode":"M.2 (2280)","ssd_type_format_family_id":1560421,"ssd_type_format_family_unicode":"M.2","ssd_type_format_family_name":"M.2","ssd_type_format_name":"M.2 (2280)","ssd_type_bus_id":1559594,"ssd_type_bus_unicode":"PCIe 4.0 x4","ssd_type_bus_bus_with_version_id":1559297,"ssd_type_bus_bus_with_version_unicode":"PCIe 4.0","ssd_type_bus_bus_with_version_bus_id":1559281,"ssd_type_bus_bus_with_version_bus_unicode":"PCIe","ssd_type_bus_bus_with_version_bus_name":"PCIe","ssd_type_bus_bus_with_version_version":"4.0","ssd_type_bus_bus_with_version_backwards_