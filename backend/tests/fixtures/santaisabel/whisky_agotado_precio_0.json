],"Color":["Oro cálido."],"Pack-Unitario":["Unitario"],"Almacenamiento":["Conservar en un lugar fresco y seco"],"Añejado":["10 años"],"Cantidad":["1 un."],"Envase":["Botella de vidrio"],"País de Origen":["Escocia"],"Sabor":["Suave y equilibrado, con notas dulces de vainilla, fruta madura, caramelo y roble americano."],"Aroma":["Fruta fresca, manzana roja y grosella, acompañadas de vainilla, toffee y nueces."],"Graduación Alcohólica":["40.0°"],"Nota":["Por Ley la venta de alcohol está prohibida para menores de 18 años."],"Ficha Técnica":["Tipo de Producto","Grado","Origen","Color","Pack-Unitario","Almacenamiento","Añejado","Cantidad","Envase","País de Origen","Sabor","Aroma","Graduación Alcohólica","Nota"],"Ingredientes":["whisky blended scotch añejado"],"Características":["Ingredientes"],"Filtros":["Origen"],"Contenido Drenado":["750 ml"],"Contenido Neto":["750 ml"],"Datos Técnicos":["Contenido Drenado","Contenido Neto"],"Energía (kCal)":["221 / 66,30"],"Porción":["30 Ml (30 ml)"],"Porciones por envase":["25"],"Información Nutricional (por 100 g / por porción)":["Energía (kCal)","Porción","Porciones por envase"],"Flag Consumo de Alcohol":["Advertencia Consumo de Alcohol"],"Recomendación de Almacenamiento":["<div style=\"font-family: Source Sans Pro, Calibri, sans-serif; color: #333; font-size: 16px; line-height: 1.6; width: 100%; text-align: left;\">\r\n  <p style=\"margin-bottom: 12px; font-size: 16px; line-height: 1.6;\">\r\n    Para asegurar la mejor conservación y sabor de tu whisky, sigue estas recomendaciones de almacenamiento.\r\n  </p>\r\n  <ul style=\"list-style-type: disc; padding-left: 20px; margin-left: 20px;\">\r\n\r\n    <li style=\"margin-bottom: 4px; line-height: 1.2; font-size: 16px;\">Conservar el whisky en un lugar fresco, seco y alejado de la luz solar directa.</li>\r\n    <li style=\"margin-bottom: 4px; line-height: 1.2; font-size: 16px;\">Mantener siempre la botella en posición vertical para preservar su calidad.</li>\r\n    <li style=\"margin-bottom: 4px; line-height: 1.2; font-size: 16px;\">Evitar la exposición a fuentes de calor o a cambios bruscos de temperatura.</li>\r\n    <li style=\"margin-bottom: 4px; line-height: 1.2; font-size: 16px;\">Una vez abierto, asegurar un cierre hermético para conservar aromas y sabor.</li>\r\n\r\n  </ul>\r\n  <div style=\"height: 14px;\"></div>\r\n</div>"],"Advertencias":["<div style=\"font-family: Source Sans Pro, Calibri, sans-serif; color: #333; font-size: 16px; line-height: 1.6; width: 100%; text-align: left;\">\r\n  <p style=\"margin-bottom: 16px;\">\r\n    Antes de consumir alcohol, considera lo siguiente:\r\n  </p>\r\n  <ul style=\"list-style-type: disc; padding-left: 20px; margin-left: 20px;\">\r\n    <li style=\"margin-bottom: 4px; line-height: 1.2; font-size: 16px;\">El consumo nocivo de alcohol daña tu salud.</li>\r\n    <li style=\"margin-bottom: 4px; line-height: 1.2; font-size: 16px;\">Todo consumo de alcohol es dañino durante el embarazo.</li>\r\n    <li style=\"margin-bottom: 4px; line-height: 1.2; font-size: 16px;\">Todo consumo de alcohol limita la capacidad de conducir.</li>\r\n    <li style=\"margin-bottom: 4px; line-height: 1.2; font-size: 16px;\">El consumo de alcohol en menores de 18 años se encuentra prohibido.</li>\r\n  </ul>\r\n\r\n  <div style=\"height: 14px;\"></div>\r\n</div>"],"Notas de Cata":["<div style=\"margin-top:20px; margin-bottom:50px; font-family:'Source Sans Pro', Calibri, sans-serif; color:#333;\">\r\n<div style=\"border:1px solid #e0e0e0; border-radius:10px; overflow:hidden; background-color:#f9f9f9; box-shadow:0 2px 6px rgba(0,0,0,0.06);\">\r\n<table style=\"width:100%; border-collapse:separate; border-spacing:0; font-family:'Source Sans Pro', Calibri, sans-serif; font-size:16px; color:#333; background-color:#f9f9f9;\">\r\n<tr style=\"background-color:#eeeeee;\"><td style=\"padding:13px 14px; font-weight:bold; width:70px; border-bottom:1px solid #e0e0e0;\">Color</td><td style=\"padding:13px 14px; border-bottom:1px solid #e0e0e0;\">Oro cálido.</td></tr>\r\n<tr style=\"background-color:#f9f9f9;\"><td style=\"padding:13px 14px; font-weight:bold; border-bottom:1px solid #e0e0e0;\">Aroma</td><td style=\"padding:13px 14px; border-bottom:1px solid #e0e0e0;\">Fruta fresca, manzana roja y grosella, acompañadas de vainilla, toffee y nueces.</td></tr>\r\n<tr style=\"background-color:#eeeeee;\"><td style=\"padding:13px 14px; font-weight:bold; border-bottom:1px solid #e0e0e0;\">Sabor</td><td style=\"padding:13px 14px; border-bottom:1px solid #e0e0e0;\">Suave y equilibrado, con notas dulces de vainilla, fruta madura, caramelo y roble americano.</td></tr>\r\n<tr style=\"background-color:#f9f9f9;\"><td style=\"padding:13px 14px; font-weight:bold;\">Final</td><td style=\"padding:13px 14px;\">Redondo, dulce y amable, con sensación suave y persistencia cálida.</td></tr>\r\n</table>\r\n</div>\r\n<p style=\"font-family:'Source Sans Pro', Calibri, sans-serif; font-size:14px; color:#666; margin-top:8px; line-height:1.4;\">*Nota: La experiencia de cata puede variar según la temperatura, el tipo de vaso y la percepción personal.*</p>\r\n<div style=\"height:14px;\"></div>\r\n</div>"],"Acerca de la marca":["<style>\r\nhtml{scrollbar-gutter:stable;interpolate-size:allow-keywords}\r\n.contenido-marca{display:block;width:100%;clear:both;box-sizing:border-box;font-family:'Source Sans Pro',Calibri,sans-serif;color:#333;font-size:16px}\r\n.logo-marca-contenedor{display:flex;width:100%;min-height:145px;align-items:center;justify-content:center;box-sizing:border-box;padding:22px;margin-bottom:12px;background:#fff;border:1px solid #e7e7e7;border-radius:16px;transition:.6s}\r\n.logo-marca{display:block;width:auto;height:auto;max-width:100%;margin:auto;object-fit:contain;transition:transform .6s}\r\n.titulo-marca{font-family:'Source Sans Pro',Calibri,sans-serif!important;font-size:20px!important;font-weight:700!important;line-height:1.3!important;color:#333!important;text-align:center!important;margin:0!important;transition