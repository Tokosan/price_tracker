ción y salida para la manguera (bolsa no incluida)\u003c\/li\u003e\n  \u003cli\u003eCubre mochila para la lluvia integrado y guardable en un bolsillo inferior\u003c\/li\u003e\n  \u003cli\u003ePanel trasero de airmesh respirable y tirantes acolchados que favorecen la ventilación\u003c\/li\u003e\n  \u003cli\u003eCierre superior con cierre que da acceso seguro al compartimento principal.\u003c\/li\u003e\n  \u003cli\u003eUsos: hiking.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003ch3\u003eTecnología\u003c\/h3\u003e\n\u003cul\u003e\n  \u003cli\u003eOmni-Tech\u003c\/li\u003e\n  \u003cli\u003eOmni-Grip\u003c\/li\u003e\n  \u003cli\u003eTechLite\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp hidden\u003e2071541-TI3\u003c\/p\u003e","published_at":"2026-10-07T15:44:10-03:00","created_at":"2026-03-11T16:33:15-03:00","vendor":"columbiacl","type":"","tags":["40% Y 50% OFF","Accesorios","BEST SELLERS 40% Y 50% OFF","Cupón Cyber","Hiking","Hombre","Invierno","Mochila","Mujer","New In","Night Sale Clb","Night sale meta","Omni-grip","Omni-tech","Precios Cyber","Recomendados","SELSEPT","Techlite","Todo Columbia Meta","TODO CYBER 30%","TODO CYBER 40% Y 50% OFF","TODO CYBER 50% OFF","TODOCYBER","Unisex","WINTERSALE"],"price":6249500,"price_min":6249500,"price_max":6249500,"available":true,"price_varies":false,"compare_at_price":12499000,"compare_at_price_min":12499000,"compare_at_price_max":12499000,"compare_at_price_varies":false,"variants":[{"id":51529563930920,"title":"O\/S","option1":"O\/S","option2":null,"option3":null,"sku":"5400589","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"name":"Mochila Unisex Triple Canyon 36L Azul Columbia - O\/S","public_title":"O\/S","options":["O\/S"],"price":6249500,"weight":0,"compare_at_price":12499000,"inventory_management":"shopify","barcode":"198711820748","quantity_rule":{"min":1,"max":null,"increment":1},"quantity_price_breaks":[],"requires_selling_plan":false,"selling_plan_allocations":[]}],"images":["\/\/cdn.shopify.co