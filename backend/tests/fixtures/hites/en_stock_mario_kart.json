    "attributesHtml": "<div id=\"especificaciones-null\" class=\"col-12 product-attributes description tab-pane card \" role=\"tabpanel\" aria-labelledby=\"tab-B\">\n\n\t<div class=\"col-sm-12 col-lg-12 product-details-content-div value content\" data-parent=\"#accordion\" id=\"especificionescontainer\">\n        \n        \n            \n                <ul class=\"product-specification-list col-lg-12\">\n                    \n                        \n\t\t\t\t\t\t<li class=\"product-specification-item row align-items-center attribute-values row\">\n                            <span class=\"product-specification-item-name col-4 offset-1 largeText active\" data-slide-to=\"0\">Producto</span>\n                            <span class=\"text col-7\">\n                                \n                                    Juego Nintendo Switch 2\n                                    \n                                \n                            </span>\n                        </li>\n                        \n                    \n                        \n\t\t\t\t\t\t<li class=\"product-specification-item row align-items-center attribute-values row\">\n                            <span class=\"product-specification-item-name col-4 offset-1 largeText \" data-slide-to=\"1\">Marca</span>\n                            <span class=\"text col-7\">\n                                \n                                    Nintendo\n                                    \n                                \n                            </span>\n                        </li>\n                        \n                    \n                        \n\t\t\t\t\t\t<li class=\"product-specification-item row align-items-center attribute-values row\">\n                            <span class=\"product-specification-item-name col-4 offset-1 largeText \" data-slide-to=\"2\">Modelo</span>\n                            <span class=\"text col-7\">\n                                \n                   