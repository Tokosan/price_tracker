ecification-item row align-items-center attribute-values row\">\n                            <span class=\"product-specification-item-name col-4 offset-1 largeText \" data-slide-to=\"16\">Vida Util</span>\n                            <span class=\"text col-7\">\n                                \n                                    5 Años\n                                    \n                                \n                            </span>\n                        </li>\n                        \n                    \n                </ul>\n            \n        \n    </div>\n</div>\n",
