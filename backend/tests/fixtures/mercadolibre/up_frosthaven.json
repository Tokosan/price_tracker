físico y su presentación en español garantizan que todos los participantes puedan seguir fácilmente las historias y las reglas del juego. Ya sea que seas un veterano en el mundo de los juegos de mesa o alguien que busca una nueva experiencia, Frosthaven es la elección perfecta para disfrutar de momentos memorables en buena compañía."}, "parent_id": null, "children_ids": [], "settings": {"content": "fixed", "listing_strategy": "catalog_required", "exclusive": false, "with_enhanced_pictures": false, "base_site_product_id": null, "ttr": "2026-09-29T21:55:55.573815337"}, "quality_type": "COMPLETE", "release_info": null, "presale_info": null, "enhanced_content": null, "tags": [], "date_created": "2025-04-15T03:38:36Z", "authorized_stores": null, "last_updated": "2026-08-26T12:44:10Z", "grouper_id": null, "experiments": {}}, "items": [{"item_id": "MLC2975624614", "site_id": "MLC", "seller_id": 550072427, "accepts_mercadopago": true, "price": 248803, "category_id": "MLC1161", "currency_id": "CLP", "warranty": "", "condition": "new", "listing_type_id": "gold_special", "international_delivery_mode": "none", "tier": "", "inventory_id": "", "tags": ["dynamic_standard_price", "first_party", "kvs_primary", "immediate_payment", "cart_eligible"], "deal_ids": [], "official_store_id": null, "original_price": 249990, "shipping": {"free_shipping": true, "store_pick_up": false, "local_pick_up": false, "mode": "me2", "logistic_type": "fulfillment", "tags": ["mandatory_free_shipping"], "cost": 0}, "seller_address": {"city": {"id": "TUxDQ1BVRDg4OWIx", "name": "Las Condes"}, "state": {"id": "TUxDUE1FVEExM2JlYg", "name": "RM (Metropolitana)"}, "neighborhood": {"id": "TVhYRW5lYVRVeERRMUJWUkRnNE9XSXg", "name": "Enea"}}, "sale_terms": [], "user_product_id": "MLCU3227804779", "min_purchase_unit": 1}, {"item_id": "MLC2079442129", "site_id": "MLC", "seller_id": 156303795, "accepts_mercadopago": true, "price": 249990, "category_id": "MLC1161", "currency_id": "CLP", "warranty": "Garantía del vended