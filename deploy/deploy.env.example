# Copiar a deploy/deploy.env (no se versiona) para usar scripts/deploy.sh desde tu máquina.

# Host SSH del servidor (alias de ~/.ssh/config), o "local" si corres el script en el servidor
TRACKER_SSH_HOST=mi-servidor
# Ruta del clon del repo en el servidor
TRACKER_REMOTE_DIR=$HOME/price_tracker
# Carpeta que sirve el reverse proxy para el frontend
TRACKER_WEB_ROOT=/var/www/tracker
TRACKER_HEALTH_URL=http://127.0.0.1:8910/api/health
# Solo para el mensaje final
TRACKER_PUBLIC_URL=https://tracker.example.com
