# Despliega origin/main si avanzó. Lo dispara tracker-autodeploy.timer.
# Instalar (reemplaza __USER__ y __APP_DIR__ por tu usuario y la ruta del clon):
#   sed -e "s|__USER__|$USER|" -e "s|__APP_DIR__|$PWD|" deploy/systemd/tracker-autodeploy.service \
#     | sudo tee /etc/systemd/system/tracker-autodeploy.service >/dev/null
#   sudo cp deploy/systemd/tracker-autodeploy.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tracker-autodeploy.timer
[Unit]
Description=Auto-deploy de price_tracker (origin/main -> prod)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/scripts/auto-deploy.sh
# Un build completo (npm ci + imagen) tarda un par de minutos.
TimeoutStartSec=15min
